{
  "name": "pebble",
  "version": "0.1.0",
  "description": "A Redis-compatible server written from scratch in TypeScript on Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iivanhaj/pebble.git"
  },
  "homepage": "https://github.com/iivanhaj/pebble#readme",
  "keywords": [
    "redis",
    "resp",
    "key-value-store",
    "in-memory-database",
    "typescript",
    "nodejs"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/main.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "bench:eviction": "npm run build && node --expose-gc dist/bench/eviction-bench.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2"
  }
}
